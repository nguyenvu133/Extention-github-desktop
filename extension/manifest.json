{
  "manifest_version": 3,
  "name": "PixiJS GitHub Desktop Sync",
  "version": "3.7.0",
  "description": "Run real Git operations on a local repository from Chrome through a secured local bridge.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "PixiJS GitHub Desktop Sync",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}