# bridge/.env.example — TEMPLATE ONLY. Copy to bridge/.env and fill it in:
#   copy bridge/.env.example bridge/.env   (Windows: copy bridge\.env.example bridge\.env)
# Or run bridge/setup-env.bat (Windows) / bridge/setup-env.sh (Mac/Linux)
# and paste the values once — the script writes bridge/.env for you.
#
# SECURITY: bridge/.env is git-ignored and must NEVER be pushed to GitHub.
# It can hold live secrets. Anyone who gets this file can act as you on
# GitHub. Never paste it into a chat, screenshot it, or email it.
#
# How it works: on startup the bridge reads bridge/.env and uses these
# values automatically — no more pasting in the dashboard. Dashboard
# OAuth/PAT saves also synchronize their corresponding keys into this
# private file; Sign out removes GITHUB_PAT. Auto-update controls sync
# their three keys here as well. A real environment variable always wins.
# Only the KEY NAMES are ever logged, never the values.

# Bridge token (extension <-> bridge). Any string, 16+ chars, no spaces.
# If set, the bridge uses it instead of generating a random one, so the
# token stays the same across restarts and fresh downloads — paste it
# into the extension ONCE and it keeps working. If empty, the bridge
# generates one and saves it to bridge/.bridge-token.
BRIDGE_TOKEN=

# Port the bridge listens on (default 17321).
BRIDGE_PORT=17321

# GitHub Personal Access Token (classic ghp_... or fine-grained
# github_pat_...). If set, the bridge signs in with it automatically
# on startup. Needs at least: repo scope (classic) or Contents +
# Pull requests + Issues read/write on your repos (fine-grained).
GITHUB_PAT=

# GitHub OAuth App (for Connect GitHub / Device Flow). Create it once at
# github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth
# App, with Authorization callback URL http://127.0.0.1:17321/api/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Local repository to select automatically on startup
# (e.g. C:\Users\you\Documents\MyRepo or /home/you/MyRepo).
# Only used when no repository was remembered from before.
DEFAULT_REPO_PATH=
# GitHub repo auto-update: polls your repositories for new commits.
# true/false; interval is clamped to 15..3600 seconds (15 sec..60 min).
GITHUB_AUTO_UPDATE_ENABLED=false
GITHUB_AUTO_UPDATE_INTERVAL_SECONDS=60
# Optional: pull new commits into the connected local repo automatically.
# Safety: bridge only attempts this when the working tree is clean.
GITHUB_AUTO_SYNC=false
